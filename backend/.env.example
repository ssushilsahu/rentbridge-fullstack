PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/rentbridge
JWT_SECRET=replace_with_at_least_32_random_characters
CLIENT_ORIGINS=http://localhost:5173
# In production, use the exact HTTPS frontend origin(s), comma separated.
# In production, point this at a persistent disk mounted for the API service.
UPLOAD_DIR=./uploads
# Set to 1 only when the app is behind one trusted reverse proxy.
TRUST_PROXY_HOPS=0
